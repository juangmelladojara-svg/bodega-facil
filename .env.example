# Bodega Fácil — Control de acceso
# Copiar a .env.local y completar. Nunca commitear el archivo real.

# URL pública del sitio (usada para armar returnUrl de Webpay)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — service_role key SOLO se usa en el backend (API routes), nunca en el cliente.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth — anon/publishable key, sí se expone al navegador (es pública por
# diseño, protegida por RLS). Se usa solo para el login del panel /admin.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Panel /admin — lista de emails autorizados a entrar (separados por coma).
# El login usa Supabase Auth, pero solo estos emails pasan el middleware,
# aunque alguien cree una cuenta por fuera de la app (signup público de Supabase).
# Crear el usuario dueño en Supabase Dashboard → Authentication → Users → Add user.
ADMIN_EMAILS=dueno@bodegarfacil.cl

# Transbank Webpay Plus
# "integration" usa las credenciales públicas de prueba del SDK (sin datos reales).
# Cambiar a "production" solo cuando exista afiliación de comercio real.
TRANSBANK_ENVIRONMENT=integration
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# Controlador Hikvision DS-K2602T — expuesto vía Cloudflare Tunnel (sin puertos abiertos)
# Ejemplo: https://control-acceso-bodegafacil.trycloudflare.com
ISAPI_BASE_URL=
ISAPI_USERNAME=
ISAPI_PASSWORD=
# Si es "true", isapi.js usa el stub en memoria en vez de llamar al hardware real.
# Útil para desarrollar/probar el flujo de pago sin controlador conectado.
ISAPI_MOCK=true

# Secreto compartido para autenticar el cron de reintento (header X-Cron-Secret)
CRON_SECRET=
